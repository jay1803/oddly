---
import { base } from '../lib/base';
import { panguSpace } from '../lib/rehype-pangu.mjs';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="application-name" content="oddly" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="oddly" />
    <meta name="theme-color" content="#f7f4ed" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#17181a" media="(prefers-color-scheme: dark)" />
    <title>{panguSpace(title)}</title>
    {description && <meta name="description" content={panguSpace(description)} />}
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
    <link rel="alternate" type="application/rss+xml" title="oddly" href={`${base}/rss.xml`} />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.dataset.theme = saved;
            document.documentElement.style.colorScheme = saved;
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="scroll-progress" data-scroll-progress><div class="scroll-progress-bar"></div></div>

    <header class="masthead">
      <div class="masthead-inner">
        <div class="masthead-title-group">
          <a class="wordmark" href={`${base}/`}>oddly</a>
        </div>
        <nav class="masthead-nav">
          <a href={`${base}/about/`}>About</a>
          <button type="button" class="refresh-button" id="refresh-button" title="Check for new content" disabled>
            Refresh
          </button>
          <button
            type="button"
            class="theme-toggle"
            id="theme-toggle"
            aria-label="Switch between light and dark theme"
          >
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <circle cx="12" cy="12" r="4.2" />
              <path d="M12 2.5v2.6M12 18.9v2.6M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M2.5 12h2.6M18.9 12h2.6M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8" stroke-linecap="round" />
            </svg>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.8 6.8 0 0 0 10.5 10.5Z" stroke-linejoin="round" />
            </svg>
          </button>
        </nav>
      </div>
      <span class="refresh-status" id="refresh-status" role="status" aria-live="polite"></span>
    </header>
    <main>
      <slot />
    </main>
    <footer class="colophon">
      <div class="colophon-inner">
        <span>oddly &nbsp;&middot;&nbsp; 新产品、新技术、AI 更新</span>
        <span>
          Designed by Claude + <a href="https://maxoxo.me" target="_blank" rel="noopener noreferrer">Max</a>
        </span>
        <a href={`${base}/rss.xml`}>RSS</a>
      </div>
    </footer>

    <script>
      const bar = document.querySelector<HTMLElement>('[data-scroll-progress] .scroll-progress-bar');
      if (bar) {
        const onScroll = () => {
          const el = document.documentElement;
          const max = el.scrollHeight - el.clientHeight;
          const pct = max > 0 ? Math.min(100, (el.scrollTop / max) * 100) : 0;
          bar.style.width = pct + '%';
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

      const themeToggle = document.getElementById('theme-toggle');
      themeToggle?.addEventListener('click', () => {
        const root = document.documentElement;
        const current =
          root.dataset.theme ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        root.style.colorScheme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });

      const refreshButton = document.querySelector<HTMLButtonElement>('#refresh-button');
      const refreshStatus = document.querySelector<HTMLElement>('#refresh-status');
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          if (refreshStatus) refreshStatus.textContent = 'Saving recent entries…';
          navigator.serviceWorker
            .register(`${import.meta.env.BASE_URL}sw.js`)
            .then(() => navigator.serviceWorker.ready)
            .then(() => {
              if (refreshStatus) refreshStatus.textContent = 'Recent 50 entries saved offline';
              if (refreshButton) refreshButton.disabled = false;
            })
            .catch(() => {
              if (refreshStatus) refreshStatus.textContent = 'Offline saving unavailable';
              if (refreshButton) refreshButton.disabled = true;
            });
        });
      } else if (refreshStatus) {
        refreshStatus.textContent = 'Offline saving unavailable';
        if (refreshButton) refreshButton.disabled = true;
      }

      refreshButton?.addEventListener('click', async () => {
        if (!refreshStatus || !refreshButton) return;
        refreshButton.disabled = true;
        refreshStatus.textContent = 'Refreshing…';
        try {
          const registration = await navigator.serviceWorker.ready;
          const worker = navigator.serviceWorker.controller || registration.active;
          if (!worker) throw new Error('Service worker unavailable');
          const channel = new MessageChannel();
          const refreshed = new Promise<void>((resolve, reject) => {
            const timeout = window.setTimeout(() => reject(new Error('Refresh timed out')), 120000);
            channel.port1.onmessage = (event) => {
              if (event.data?.progress) {
                refreshStatus.textContent = `Refreshing… ${event.data.progress}`;
                return;
              }
              window.clearTimeout(timeout);
              channel.port1.close();
              event.data?.ok ? resolve() : reject(new Error('Refresh failed'));
            };
          });
          worker.postMessage({ type: 'REFRESH', url: location.href }, [channel.port2]);
          await refreshed;
          refreshStatus.textContent = 'Updated';
          location.reload();
        } catch {
          refreshStatus.textContent = 'Could not refresh. Check your connection.';
          refreshButton.disabled = false;
        }
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --paper: #f7f4ed;
    --paper-raised: #f1ede3;
    --line: #e3ded2;
    --line-soft: #ecE7db;
    --ink: #1e1c19;
    --ink-soft: #5d574d;
    --ink-faint: #6f695d;
    --accent: #2f5d50;
    --accent-soft: #c9d8d0;
    --selection: #d8e2dc;

    --font-display: Georgia, Cambria, 'Times New Roman', 'PingFang SC', 'Noto Sans SC', 'Microsoft YaHei', serif;
    --font-em: Georgia, Cambria, 'Times New Roman', 'Kaiti SC', 'STKaiti', 'KaiTi', 'Noto Serif SC', serif;
    --font-mono: 'TX-02', ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;

    --measure: 41.25rem;
    --wide: 67.5rem;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --paper: #17181a;
      --paper-raised: #202124;
      --line: #333429;
      --line-soft: #2a2b27;
      --ink: #e8e4d9;
      --ink-soft: #a9a493;
      --ink-faint: #948c7c;
      --accent: #6fae94;
      --accent-soft: #2c4139;
      --selection: #2c4139;
    }
  }
  :root[data-theme='dark'] {
    --paper: #17181a;
    --paper-raised: #202124;
    --line: #333429;
    --line-soft: #2a2b27;
    --ink: #e8e4d9;
    --ink-soft: #a9a493;
    --ink-faint: #948c7c;
    --accent: #6fae94;
    --accent-soft: #2c4139;
    --selection: #2c4139;
  }

  * {
    box-sizing: border-box;
  }

  html {
    color-scheme: light dark;
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 17px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    /* Chinese has no true italic form — without this, browsers fake it by
       slanting CJK glyphs, which just looks broken. Combined with --font-em
       (Kaiti stands in for italic emphasis in CJK), this keeps Latin text
       genuinely italic while CJK renders upright in Kaiti instead.
       ("style none" is invalid — font-synthesis takes either the single
       keyword none, or a list of the features still allowed to synthesize.) */
    font-synthesis: weight small-caps;
  }

  ::selection {
    background: var(--selection);
  }

  a {
    color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  a:hover {
    color: var(--ink);
  }
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: transparent;
    z-index: 20;
  }
  .scroll-progress-bar {
    height: 100%;
    background: var(--accent);
    width: 0%;
    transition: width 0.12s linear;
  }

  .masthead {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .masthead-inner {
    max-width: var(--wide);
    margin: 0 auto;
    padding: 0.9rem 2.5rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .masthead-title-group {
    display: flex;
    align-items: baseline;
    gap: 0.875rem;
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.35rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
  }
  .masthead-nav {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .masthead-nav a {
    color: var(--ink-soft);
    text-decoration: none;
  }
  .masthead-nav a:hover {
    color: var(--ink);
  }

  .refresh-button {
    appearance: none;
    border: 0;
    padding: 0;
    background: transparent;
    color: var(--ink-soft);
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
  }
  .refresh-button:hover {
    color: var(--ink);
  }
  .refresh-button:disabled {
    cursor: wait;
    opacity: 0.5;
  }
  .refresh-status {
    display: block;
    max-width: var(--wide);
    min-height: 0;
    margin: 0 auto;
    padding: 0 2.5rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--ink-soft);
  }
  .refresh-status:empty {
    display: none;
  }

  .theme-toggle {
    appearance: none;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink-soft);
    width: 1.9rem;
    height: 1.9rem;
    padding: 0;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .theme-toggle:hover {
    color: var(--ink);
    border-color: var(--ink-faint);
  }
  .theme-toggle svg {
    width: 15px;
    height: 15px;
  }
  .theme-toggle .icon-moon {
    display: none;
  }
  :root[data-theme='dark'] .theme-toggle .icon-sun {
    display: none;
  }
  :root[data-theme='dark'] .theme-toggle .icon-moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .theme-toggle .icon-sun {
      display: none;
    }
    :root:not([data-theme='light']) .theme-toggle .icon-moon {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .masthead-inner {
      padding: 0.7rem 1.25rem;
      gap: 0.75rem;
    }
    .wordmark {
      font-size: 1.05rem;
    }
    .masthead-nav {
      gap: 0.9rem;
      font-size: 0.62rem;
    }
    .refresh-status {
      padding: 0 1.25rem;
    }
    .theme-toggle {
      width: 1.6rem;
      height: 1.6rem;
    }
    .theme-toggle svg {
      width: 13px;
      height: 13px;
    }
  }

  main {
    max-width: var(--wide);
    margin: 0 auto;
    padding: 0 2.5rem;
  }
  @media (max-width: 640px) {
    main {
      padding: 0 1.25rem;
    }
    .prose p {
      font-size: 16px;
      line-height: 2;
    }
  }

  .prose {
    color: var(--ink);
    overflow-wrap: break-word;
    word-break: break-word;
  }
  .prose p {
    font-size: 1.15rem;
    line-height: 1.78;
    margin: 0 0 1.7rem;
    text-wrap: pretty;
    overflow-wrap: break-word;
    word-break: break-word;
  }
  .prose h1,
  .prose h2,
  .prose h3 {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink-faint);
    margin: 3em 0 1.2em;
  }
  .prose ul,
  .prose ol {
    margin: 0 0 1.7rem;
    padding-left: 1.3em;
    font-size: 1.15rem;
    line-height: 1.7;
  }
  .prose li {
    margin-bottom: 0.5em;
  }
  .prose blockquote {
    margin: 2.5rem 0;
    padding: 0 0 0 1.75rem;
    border-left: 2px solid var(--accent-soft);
    color: var(--accent);
    font-size: 1.4rem;
    line-height: 1.45;
    font-style: italic;
    font-family: var(--font-em);
    letter-spacing: -0.01em;
  }
  .prose em,
  .prose i {
    font-style: italic;
    font-family: var(--font-em);
  }
  .prose code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--paper-raised);
    padding: 0.1em 0.35em;
    border-radius: 3px;
  }
  .prose pre {
    background: var(--paper-raised);
    padding: 1em;
    border-radius: 4px;
    overflow-x: auto;
  }
  .prose pre code {
    background: none;
    padding: 0;
  }
  .prose strong {
    font-weight: 600;
  }
  .prose a {
    color: var(--accent);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .colophon {
    border-top: 1px solid var(--line);
    background: var(--paper-raised);
  }
  .colophon-inner {
    max-width: var(--wide);
    margin: 0 auto;
    padding: 3.5rem 2.5rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .colophon a {
    color: var(--ink-soft);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  .colophon a:hover {
    color: var(--ink);
  }
  @media (max-width: 640px) {
    .colophon-inner {
      padding: 2.5rem 1.25rem;
    }
  }
</style>
