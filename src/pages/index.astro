---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const CATEGORY_LABEL = {
  product: '产品',
  model: '模型',
  tool: '工具',
  idea: '点子',
  other: '其他',
};

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const entries = await Promise.all(
  posts.map(async (post) => ({ post, Content: (await render(post)).Content }))
);
---
<BaseLayout title="oddly" description="每天从 X 时间线上筛选的新奇发现:新产品、新模型、有趣的点子。">
  <div class="hero">
    <p class="hero-eyebrow"><span id="visible-count">{posts.length}</span> finds</p>
    <h1 class="hero-title">时间线上的新奇玩意</h1>
    <p class="hero-dek">每天从 X 时间线筛选的新鲜发现——新产品、新 AI 模型、有意思的点子。没有算法，只是好奇心。</p>
  </div>
  <div class="filter-tabs" role="tablist" aria-label="按类型筛选">
    <button class="tab active" data-filter="all" role="tab" aria-selected="true">全部</button>
    <button class="tab" data-filter="product" role="tab" aria-selected="false">产品</button>
    <button class="tab" data-filter="tool" role="tab" aria-selected="false">工具</button>
    <button class="tab" data-filter="model" role="tab" aria-selected="false">模型</button>
  </div>
  <div class="feed" id="feed">
    {entries.map(({ post, Content }) => (
      <article class="card" data-category={post.data.category}>
        <div class="card-meta">
          <span class="cat">{CATEGORY_LABEL[post.data.category] ?? post.data.category}</span>
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toISOString().slice(0, 10)}
          </time>
        </div>
        <h2 class="card-title"><a href={`/${post.id}/`}>{post.data.title}</a></h2>
        {post.data.description && <p class="card-desc">{post.data.description}</p>}
        <div class="card-body"><Content /></div>
        <div class="card-links">
          {post.data.tweet_url && <a href={post.data.tweet_url} target="_blank" rel="noopener">原推文</a>}
          {post.data.source && <a href={post.data.source} target="_blank" rel="noopener">链接</a>}
          {post.data.author && <span class="author">· {post.data.author}</span>}
        </div>
      </article>
    ))}
  </div>
  {entries.length === 0 && <p class="empty">还没有条目。等明天的采集跑一轮。</p>}
  <p class="empty" id="empty-filtered" style="display: none;">这个分类下还没有条目。</p>
</BaseLayout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab');
  const cards = document.querySelectorAll<HTMLElement>('.card');
  const countEl = document.getElementById('visible-count');
  const emptyEl = document.getElementById('empty-filtered');

  function applyFilter(filter: string) {
    let visible = 0;
    cards.forEach((card) => {
      const match = filter === 'all' || card.dataset.category === filter;
      card.style.display = match ? '' : 'none';
      if (match) visible++;
    });
    if (countEl) countEl.textContent = String(visible);
    if (emptyEl) emptyEl.style.display = visible === 0 ? '' : 'none';
    tabs.forEach((tab) => {
      const active = tab.dataset.filter === filter;
      tab.classList.toggle('active', active);
      tab.setAttribute('aria-selected', String(active));
    });
    history.replaceState(null, '', filter === 'all' ? location.pathname : `?filter=${filter}`);
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => applyFilter(tab.dataset.filter || 'all'));
  });

  const initial = new URLSearchParams(location.search).get('filter');
  if (initial && ['product', 'tool', 'model'].includes(initial)) {
    applyFilter(initial);
  }
</script>

<style>
  .hero { padding: 3rem 0 2rem; }
  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0 0 1.25rem;
  }
  .hero-title {
    font-size: clamp(2rem, 1.6rem + 1.6vw, 2.75rem);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }
  .hero-dek { color: var(--ink-soft); max-width: 56ch; margin: 0; }
  .filter-tabs {
    display: flex;
    gap: 0.5rem;
    margin: 0 0 2rem;
    flex-wrap: wrap;
  }
  .tab {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--ink-soft);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.4rem 1rem;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .tab:hover { color: var(--ink); border-color: var(--ink-faint); }
  .tab.active {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
    font-weight: 600;
  }
  .feed { display: flex; flex-direction: column; gap: 1.5rem; }
  .card {
    border: 1px solid var(--border);
    background: var(--bg-soft);
    border-radius: 12px;
    padding: 1.5rem;
  }
  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-faint);
    margin-bottom: 0.6rem;
  }
  .cat {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
  }
  .card-title { font-size: 1.25rem; margin: 0 0 0.5rem; line-height: 1.3; }
  .card-title a { color: var(--ink); text-decoration: none; }
  .card-title a:hover { color: var(--accent); }
  .card-desc { color: var(--ink-soft); margin: 0 0 0.75rem; }
  .card-body { color: var(--ink-soft); font-size: 0.95rem; }
  .card-body :global(p:first-child) { margin-top: 0; }
  .card-links {
    margin-top: 1rem;
    display: flex;
    gap: 1rem;
    font-size: 0.85rem;
    flex-wrap: wrap;
  }
  .author { color: var(--ink-faint); }
  .empty { color: var(--ink-faint); padding: 2rem 0; }
</style>
