---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { base } from '../lib/base';
import { buildAskChatGptUrl } from '../lib/ask-chatgpt';
import { categoryLabel, formatDate } from '../lib/categories';
import { isDekRedundant } from '../lib/dedupeDek';
import { panguSpace } from '../lib/rehype-pangu.mjs';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { data } = post;
const showDek = data.description && !isDekRedundant(post.id, data.description);
---

<BaseLayout title={`${data.title} — oddly`} description={data.description}>
  <a class="back-link" href={`${base}/`}>&larr; 返回首页</a>
  <article class="single-entry">
    <div class="entry-eyebrow">
      <span>{formatDate(data.date)}</span>
      <span class="dot-rule"></span>
      <a href={`${base}/category/${data.category}/`}>{categoryLabel(data.category)}</a>
    </div>
    <h1 class="entry-title">{panguSpace(data.title)}</h1>
    {showDek && <p class="entry-dek">{panguSpace(data.description!)}</p>}
    <div class="prose">
      <Content />
    </div>
    {
      data.tweet_url && (
        <div class="tweet-embed">
          <blockquote class="twitter-tweet" data-dnt="true">
            <a href={data.tweet_url}></a>
          </blockquote>
        </div>
      )
    }
    <footer class="entry-foot">
      <span class="entry-tags">
        {data.author && <span>{data.author}</span>}
        {
          data.tweet_url && (
            <>
              {data.author && <span aria-hidden="true">&middot;</span>}
              <a href={data.tweet_url} target="_blank" rel="noopener noreferrer">原推文 ↗</a>
            </>
          )
        }
        {
          data.source && (
            <>
              {(data.author || data.tweet_url) && <span aria-hidden="true">&middot;</span>}
              <a href={data.source} target="_blank" rel="noopener noreferrer">来源 ↗</a>
            </>
          )
        }
        <span aria-hidden="true">&middot;</span>
        <a class="ask-gpt" href={buildAskChatGptUrl(data)} target="_blank" rel="noopener noreferrer">✦ Ask ChatGPT</a>
      </span>
    </footer>
  </article>
  {
    data.tweet_url && (
      <script is:inline>
        {`(function () {
          var t = document.documentElement.dataset.theme ||
            (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.querySelectorAll('.twitter-tweet').forEach(function (el) { el.setAttribute('data-theme', t); });
          var s = document.createElement('script');
          s.async = true; s.charset = 'utf-8'; s.src = 'https://platform.twitter.com/widgets.js';
          document.body.appendChild(s);
        })();`}
      </script>
    )
  }
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    margin: 2rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    text-decoration: none;
  }
  .back-link:hover {
    color: var(--accent);
  }
  .single-entry {
    max-width: var(--measure);
    padding: 2.5rem 0 6rem;
  }
  .entry-eyebrow {
    display: flex;
    align-items: baseline;
    gap: 0.875rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 1.5rem;
  }
  .entry-eyebrow a {
    color: var(--ink-soft);
    text-decoration: none;
  }
  .entry-eyebrow a:hover {
    color: var(--accent);
  }
  .dot-rule {
    width: 14px;
    height: 1px;
    background: var(--line);
  }
  .entry-title {
    font-size: clamp(2rem, 1.6rem + 1.8vw, 3rem);
    line-height: 1.12;
    font-weight: 400;
    letter-spacing: -0.022em;
    margin: 0 0 1.1rem;
    text-wrap: balance;
  }
  .entry-dek {
    font-size: 1.2rem;
    line-height: 1.6;
    font-style: italic;
    font-family: var(--font-em);
    color: var(--ink-soft);
    margin: 0 0 2.5rem;
    text-wrap: pretty;
  }
  .tweet-embed {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }
  .tweet-embed :global(.twitter-tweet) {
    margin: 0 auto !important;
  }
  .entry-foot {
    margin: 3rem 0 0;
    padding-top: 1.35rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .entry-tags {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
  }
  .entry-tags a {
    color: var(--ink-soft);
    text-decoration: none;
  }
  .entry-tags a:hover {
    color: var(--ink);
  }
  .entry-tags .ask-gpt {
    color: var(--accent);
  }
</style>
