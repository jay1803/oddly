---
import { base } from 'astro-reading-theme/lib/base.ts';
import { TAB_CATEGORIES, categoryLabel } from '../lib/categories';

interface Props {
  active?: string;
}
const { active = 'all' } = Astro.props;
const tabs = [
  { key: 'all', label: '全部', href: `${base}/` },
  ...TAB_CATEGORIES.map((c) => ({ key: c, label: categoryLabel(c), href: `${base}/category/${c}/` })),
];
---

<nav class="tabs" aria-label="按类型筛选">
  {
    tabs.map((tab) => (
      <a class:list={['tab', { active: tab.key === active }]} href={tab.href} aria-current={tab.key === active ? 'page' : undefined}>
        {tab.label}
      </a>
    ))
  }
</nav>

<style>
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    max-width: var(--measure);
    margin: 2.5rem 0 0;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-sans);
    font-size: 0.875rem;
  }
  .tab {
    padding: 0.75rem 0;
    margin-bottom: -1px;
    border-bottom: 1px solid transparent;
    color: var(--ink-3);
    text-decoration: none;
  }
  .tab:hover {
    color: var(--ink);
  }
  .tab.active {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }
</style>
