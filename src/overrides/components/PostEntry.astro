---
// oddly's feed entry: the theme's 0.3 layout plus a category link, the description as a dek,
// and tweet / source / Ask ChatGPT links. Reading time and dates come from the theme.
import { base } from 'astro-reading-theme/lib/base.ts';
import { readingMinutes } from 'astro-reading-theme/lib/readingTime.ts';
import { getDomain } from 'astro-reading-theme/lib/domain.ts';
import { isDekRedundant } from 'astro-reading-theme/lib/dedupeDek.ts';
import { panguSpace } from 'astro-reading-theme/lib/rehype-pangu.mjs';
import { t, formatDate, entryNumber } from 'astro-reading-theme/lib/i18n.ts';
import EntrySide from 'astro-reading-theme/components/EntrySide.astro';
import { buildAskChatGptUrl } from '../../lib/ask-chatgpt';
import { categoryLabel } from '../../lib/categories';

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      date: Date;
      category: string;
      description?: string;
      source?: string;
      tweet_url?: string;
      author?: string;
    };
  };
  Content: any;
  num: number;
  headings?: { depth: number; slug: string; text: string }[];
}
const { post, Content, num, headings = [] } = Astro.props;
const { data } = post;
const title = panguSpace(data.title);
const numLabel = entryNumber(num);
const minutes = readingMinutes(post.id);
const domain = data.source ? getDomain(data.source) : null;
const permalink = `${base}/${post.id}/`;
const showDek = data.description && !isDekRedundant(post.id, data.description);
---

<article
  class="entry"
  id={`p-${post.id}`}
  aria-labelledby={`t-${post.id}`}
  data-entry
  data-num={numLabel}
  data-title={title}
  data-minutes={t.minutes(minutes)}
>
  <div class="entry-main">
    <p class="entry-num">{numLabel}</p>
    <p class="entry-meta">
      <a href={`${base}/category/${data.category}/`}>{categoryLabel(data.category)}</a>
      <span class="meta-narrow" aria-hidden="true">·</span>
      <span class="meta-narrow">{formatDate(data.date)}</span>
      {
        data.author && (
          <>
            <span class="meta-narrow" aria-hidden="true">·</span>
            <span class="meta-narrow">{data.author}</span>
          </>
        )
      }
    </p>

    <h2 class="entry-title" id={`t-${post.id}`}><a href={permalink}>{title}</a></h2>
    {showDek && <p class="entry-dek">{panguSpace(data.description!)}</p>}

    <div class="prose entry-content">
      <Content />
    </div>

    <p class="entry-links">
      {
        data.tweet_url && (
          <a href={data.tweet_url} target="_blank" rel="noopener noreferrer">原推文 ↗</a>
        )
      }
      {
        data.source && (
          <a href={data.source} target="_blank" rel="noopener noreferrer">来源 ↗</a>
        )
      }
      <a href={buildAskChatGptUrl(data)} target="_blank" rel="noopener noreferrer" title="在 ChatGPT 中详细了解这条内容">✦ Ask ChatGPT</a>
      <a href={permalink}>{t.permalink}</a>
    </p>
  </div>

  <EntrySide
    label={`${numLabel} ${t.entryInfo}`}
    date={data.date}
    minutes={minutes}
    domain={domain}
    author={data.author}
    source={data.source}
    headings={headings}
    tocBase={permalink}
  />
</article>

<script>
  // In a feed several entries can share a heading id, so section links scroll to the
  // heading inside their own entry instead of relying on the URL fragment.
  document.addEventListener('click', (event) => {
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('.entry a[data-toc-slug]');
    if (!link) return;
    const entry = link.closest<HTMLElement>('[data-entry]');
    const slug = link.dataset.tocSlug;
    const heading = slug ? entry?.querySelector<HTMLElement>(`[id="${CSS.escape(slug)}"]`) : null;
    if (!heading) return;
    event.preventDefault();
    heading.scrollIntoView({ block: 'start' });
  });
</script>

<style>
  /* Entries are short, so they sit closer together than in the theme (11rem). */
  .entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-top: 7rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule-strong);
    scroll-margin-top: 6.5rem;
  }
  .entry-main {
    min-width: 0;
  }
  .entry-num {
    margin: 0 0 1.25rem;
    font-family: var(--font-sans);
    font-size: clamp(2.75rem, 5vw, 4rem);
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.045em;
    color: var(--num);
    font-variant-numeric: tabular-nums;
  }
  .entry-meta {
    margin: 0 0 0.625rem;
    display: flex;
    flex-wrap: wrap;
    gap: 2px 8px;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--ink-3);
  }
  .entry-meta a {
    text-decoration: none;
  }
  .entry-meta a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .entry-title {
    max-width: var(--measure);
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1.375rem, 2.4vw, 1.625rem);
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.014em;
    text-wrap: balance;
  }
  .entry-title a {
    color: var(--ink);
    text-decoration: none;
  }
  .entry-title a:hover {
    color: var(--ink-2);
  }
  .entry-dek {
    max-width: var(--measure);
    margin: 0.75rem 0 0;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  :root:lang(zh) .entry-dek {
    letter-spacing: 0.01em;
  }
  .entry-content {
    max-width: var(--measure);
    margin-top: 1.25rem;
  }
  .entry-links {
    margin: 1.25rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--ink-2);
  }
  .entry-links a {
    padding: 0.75rem 0;
  }
  @media (min-width: 1080px) {
    .entry {
      grid-template-columns: minmax(0, var(--measure)) var(--side);
      justify-content: space-between;
      column-gap: 3rem;
    }
    /* The side rail shows date and author on wide screens; the category stays here. */
    .meta-narrow {
      display: none;
    }
  }
</style>
