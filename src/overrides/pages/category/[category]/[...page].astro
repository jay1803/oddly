---
// oddly's category feed: the theme's 0.3 page plus Chinese category labels, category tabs,
// the site page size, and empty pages for every tab category.
import { byDateDesc } from 'astro-reading-theme/lib/sort.ts';
import site from 'virtual:astro-reading-theme/config';
import { getCollection, render } from 'astro:content';
import BaseLayout from 'astro-reading-theme/layouts/BaseLayout.astro';
import InfiniteFeed from 'astro-reading-theme/components/InfiniteFeed.astro';
import FeedBar from 'astro-reading-theme/components/FeedBar.astro';
import { t } from 'astro-reading-theme/lib/i18n.ts';
import CategoryTabs from '../../../../components/CategoryTabs.astro';
import { FEED_PAGE_SIZE } from '../../../../lib/feed';
import { TAB_CATEGORIES, categoryLabel } from '../../../../lib/categories';

export async function getStaticPaths({ paginate }) {
  const posts = await getCollection('posts');
  // Always emit the tab categories so a tab never 404s, even when empty.
  const categories = [...new Set([...TAB_CATEGORIES, ...posts.map((p) => p.data.category)])];
  return categories.flatMap((category) =>
    paginate(
      posts
        .filter((post) => post.data.category === category)
        .sort(byDateDesc),
      { params: { category }, pageSize: FEED_PAGE_SIZE }
    )
  );
}

const { category } = Astro.params;
const { page } = Astro.props;
const entries = await Promise.all(
  page.data.map(async (post, i) => {
    const { Content, headings } = await render(post);
    return { post, Content, headings, num: page.total - (page.start + i) };
  })
);
const label = categoryLabel(category);
---

<BaseLayout title={`${label} — ${site.name}`}>
  <FeedBar slot="subbar" entries={entries} total={page.total} />
  {
    page.currentPage === 1 && (
      <header class="page-head">
        <p class="page-eyebrow">{t.inCategory(page.total, label)}</p>
        <h1 class="page-title">{label}</h1>
      </header>
    )
  }
  {page.currentPage === 1 && <CategoryTabs active={category} />}
  <InfiniteFeed entries={entries} nextUrl={page.url.next} total={page.total} />
</BaseLayout>
