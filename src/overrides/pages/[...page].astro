---
// oddly's home feed: the theme's 0.3 page plus category tabs and a redirect for old
// ?filter= links. Page size comes from src/lib/feed.ts.
import { byDateDesc } from 'astro-reading-theme/lib/sort.ts';
import site from 'virtual:astro-reading-theme/config';
import { getCollection, render } from 'astro:content';
import BaseLayout from 'astro-reading-theme/layouts/BaseLayout.astro';
import InfiniteFeed from 'astro-reading-theme/components/InfiniteFeed.astro';
import FeedBar from 'astro-reading-theme/components/FeedBar.astro';
import { getDomain } from 'astro-reading-theme/lib/domain.ts';
import { slugifyAuthor } from 'astro-reading-theme/lib/author.ts';
import { panguSpace } from 'astro-reading-theme/lib/rehype-pangu.mjs';
import { t } from 'astro-reading-theme/lib/i18n.ts';
import CategoryTabs from '../../components/CategoryTabs.astro';
import { FEED_PAGE_SIZE } from '../../lib/feed';

export async function getStaticPaths({ paginate }) {
  const posts = (await getCollection('posts')).sort(byDateDesc);
  return paginate(posts, { pageSize: FEED_PAGE_SIZE });
}

const { page } = Astro.props;
const entries = await Promise.all(
  page.data.map(async (post, i) => {
    const { Content, headings } = await render(post);
    return { post, Content, headings, num: page.total - (page.start + i) };
  })
);

const allPosts = await getCollection('posts');
const earliest = new Date(Math.min(...allPosts.map((p) => p.data.date.valueOf())));
const domainCount = new Set(allPosts.map((p) => (p.data.source ? getDomain(p.data.source) : null)).filter(Boolean)).size;
const authorCount = new Set(allPosts.map((p) => (p.data.author ? slugifyAuthor(p.data.author) : '')).filter(Boolean)).size;
const titleWords = site.name.split(/\s+/).filter(Boolean);
---

<BaseLayout title={site.name} description={site.description}>
  <script is:inline>
    // Legacy filter links (?filter=tool) now live on real category pages.
    (function () {
      var f = new URLSearchParams(location.search).get('filter');
      if (f && /^(product|tool|model)$/.test(f)) location.replace('/category/' + f + '/');
    })();
  </script>
  <FeedBar slot="subbar" entries={entries} total={page.total} />
  {
    page.currentPage === 1 && (
      <section class="hero">
        <h1 class="hero-title">
          {titleWords.map((word) => (
            <span>{word}</span>
          ))}
        </h1>
        {site.dek.length > 0 && (
          <p class="hero-dek">
            {site.dek.map((line) => (
              <span>{panguSpace(line)}</span>
            ))}
          </p>
        )}
        <p class="hero-meta">
          <span>{t.entries(page.total)}</span>
          {domainCount > 0 && (
            <>
              <span aria-hidden="true">·</span>
              <span>{t.sources(domainCount)}</span>
            </>
          )}
          {authorCount > 0 && (
            <>
              <span aria-hidden="true">·</span>
              <span>{t.authors(authorCount)}</span>
            </>
          )}
          {allPosts.length > 0 && (
            <>
              <span aria-hidden="true">·</span>
              <span>{t.since(earliest)}</span>
            </>
          )}
        </p>
      </section>
    )
  }
  {page.currentPage === 1 && <CategoryTabs active="all" />}
  <InfiniteFeed entries={entries} nextUrl={page.url.next} total={page.total} />
</BaseLayout>

<style>
  .hero {
    padding: 6rem 0 0;
  }
  .hero-title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(3.75rem, 9.2vw, 7.25rem);
    line-height: 0.9;
    font-weight: 900;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .hero-title span {
    display: block;
  }
  .hero-dek {
    max-width: 36rem;
    margin: 2rem 0 0;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.85;
    color: var(--text);
  }
  :root:lang(zh) .hero-dek {
    letter-spacing: 0.015em;
  }
  .hero-dek span {
    display: block;
  }
  .hero-meta {
    margin: 1.25rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 2px 8px;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--ink-3);
  }
  @media (max-width: 640px) {
    .hero {
      padding-top: 4rem;
    }
  }
</style>
