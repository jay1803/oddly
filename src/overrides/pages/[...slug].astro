---
// oddly's post page: the theme's 0.3 layout plus a category link, the embedded tweet,
// and tweet / Ask ChatGPT links. No listen button (features.listen is off).
import site from 'virtual:astro-reading-theme/config';
import { getCollection, render } from 'astro:content';
import BaseLayout from 'astro-reading-theme/layouts/BaseLayout.astro';
import EntrySide from 'astro-reading-theme/components/EntrySide.astro';
import PostBar from 'astro-reading-theme/components/PostBar.astro';
import { base } from 'astro-reading-theme/lib/base.ts';
import { byDateDesc } from 'astro-reading-theme/lib/sort.ts';
import { readingMinutes } from 'astro-reading-theme/lib/readingTime.ts';
import { getDomain } from 'astro-reading-theme/lib/domain.ts';
import { isDekRedundant } from 'astro-reading-theme/lib/dedupeDek.ts';
import { panguSpace } from 'astro-reading-theme/lib/rehype-pangu.mjs';
import { t, formatDate, entryNumber } from 'astro-reading-theme/lib/i18n.ts';
import { buildAskChatGptUrl } from '../../lib/ask-chatgpt';
import { categoryLabel } from '../../lib/categories';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).sort(byDateDesc);
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      num: posts.length - i,
      newer: i > 0 ? posts[i - 1] : null,
      older: i < posts.length - 1 ? posts[i + 1] : null,
    },
  }));
}

const { post, num, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const { data } = post;
const numLabel = entryNumber(num);
const title = panguSpace(data.title);
const minutes = readingMinutes(post.id);
const domain = data.source ? getDomain(data.source) : null;
const showDek = data.description && !isDekRedundant(post.id, data.description);
const sections = headings.filter((h) => h.depth === 2);
---

<BaseLayout title={`${data.title} — ${site.name}`} description={data.description}>
  <PostBar slot="subbar" num={numLabel} title={data.title} sections={sections} />

  <article class="post" aria-labelledby="post-title">
    <div class="post-main single-entry">
      <a class="back-link" href={`${base}/`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 18l-6-6 6-6" />
        </svg>
        {t.allEntries}
      </a>

      <p class="post-meta">
        <span>{numLabel}</span>
        <span aria-hidden="true">·</span>
        <a href={`${base}/category/${data.category}/`}>{categoryLabel(data.category)}</a>
        {
          data.author && (
            <>
              <span aria-hidden="true">·</span>
              <span>{data.author}</span>
            </>
          )
        }
        <span aria-hidden="true">·</span>
        <span>{formatDate(data.date)}</span>
      </p>

      <h1 id="post-title" class="post-title entry-title">{title}</h1>
      {showDek && <p class="post-dek entry-dek">{panguSpace(data.description!)}</p>}

      <div class="prose post-body">
        <Content />
      </div>

      {
        data.tweet_url && (
          <div class="tweet-embed">
            <blockquote class="twitter-tweet" data-dnt="true">
              <a href={data.tweet_url}></a>
            </blockquote>
          </div>
        )
      }

      {
        data.source && (
          <a class="source-card" href={data.source} target="_blank" rel="noopener noreferrer">
            <span class="source-text">
              <span class="source-meta">
                {domain}
                {data.author && ` · ${data.author}`}
              </span>
              <span class="source-title">{title}</span>
            </span>
            <span class="source-action">
              {t.readSource}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17L17 7" />
                <path d="M8 7h9v9" />
              </svg>
            </span>
          </a>
        )
      }

      <p class="post-links">
        {
          data.tweet_url && (
            <a href={data.tweet_url} target="_blank" rel="noopener noreferrer">原推文 ↗</a>
          )
        }
        <a href={buildAskChatGptUrl(data)} target="_blank" rel="noopener noreferrer" title="在 ChatGPT 中详细了解这条内容">✦ Ask ChatGPT</a>
      </p>
    </div>

    <EntrySide
      label={`${numLabel} ${t.entryInfo}`}
      date={data.date}
      minutes={minutes}
      domain={domain}
      author={data.author}
      source={data.source}
      headings={headings}
      offset="7.5rem"
    />
  </article>

  <nav class="post-nav" aria-label={t.postNav}>
    {
      newer ? (
        <a class="post-nav-link" href={`${base}/${newer.id}/`}>
          <span class="post-nav-label">{t.newer}</span>
          <span class="post-nav-title">{panguSpace(newer.data.title)}</span>
        </a>
      ) : (
        <a class="post-nav-link" href={`${base}/`}>
          <span class="post-nav-label">{t.back}</span>
          <span class="post-nav-title">{t.allEntries}</span>
        </a>
      )
    }
    {
      older && (
        <a class="post-nav-link is-older" href={`${base}/${older.id}/`}>
          <span class="post-nav-label">{t.older}</span>
          <span class="post-nav-title">{panguSpace(older.data.title)}</span>
        </a>
      )
    }
  </nav>

  {
    data.tweet_url && (
      <script is:inline>
        {`(function () {
          var t = document.documentElement.dataset.theme ||
            (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.querySelectorAll('.twitter-tweet').forEach(function (el) { el.setAttribute('data-theme', t); });
          var s = document.createElement('script');
          s.async = true; s.charset = 'utf-8'; s.src = 'https://platform.twitter.com/widgets.js';
          document.body.appendChild(s);
        })();`}
      </script>
    )
  }
</BaseLayout>

<style>
  .post {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    --side-top: 6rem;
  }
  .post-main {
    min-width: 0;
    max-width: var(--measure);
    padding-top: 2.5rem;
  }
  @media (min-width: 1080px) {
    .post {
      grid-template-columns: minmax(0, var(--measure)) var(--side);
      justify-content: space-between;
      column-gap: 3rem;
    }
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0.75rem 0;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--ink-3);
    text-decoration: none;
  }
  .back-link:hover {
    color: var(--ink);
  }
  .back-link svg {
    width: 14px;
    height: 14px;
  }

  .post-meta {
    margin: 2.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 2px 8px;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .post-meta a {
    text-decoration: none;
  }
  .post-meta a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .post-title {
    margin: 0.875rem 0 0;
    font-family: var(--font-sans);
    font-size: clamp(2.125rem, 4.6vw, 3.25rem);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-wrap: balance;
  }
  .post-dek {
    margin: 1.5rem 0 0;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--ink-2);
  }
  :root:lang(zh) .post-dek {
    letter-spacing: 0.01em;
  }

  .post-body {
    margin-top: 3.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule);
    counter-reset: section;
  }
  /* Each top-level section reads like a chapter: rule, number, title. */
  .post-body > :global(h2) {
    counter-increment: section;
    margin: 4.5rem 0 1.125rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    font-size: 1.3em;
    line-height: 1.4;
    letter-spacing: -0.008em;
    scroll-margin-top: 7.5rem;
  }
  .post-body > :global(h2::before) {
    content: counter(section, decimal-leading-zero);
    display: block;
    margin-bottom: 0.625rem;
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .tweet-embed {
    margin-top: 2.5rem;
    max-width: 100%;
    overflow: hidden;
  }
  .tweet-embed :global(.twitter-tweet) {
    margin: 0 !important;
  }

  .source-card {
    margin-top: 2.5rem;
    padding: 1.125rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid var(--rule);
    border-radius: 10px;
    font-family: var(--font-sans);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.15s,
      background-color 0.15s;
  }
  .source-card:hover {
    border-color: var(--rule-strong);
    background: var(--surface);
  }
  .source-text {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .source-meta {
    font-size: 0.8125rem;
    color: var(--ink-3);
    overflow-wrap: anywhere;
  }
  .source-title {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .source-action {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.875rem;
    color: var(--ink-2);
  }
  .source-action svg {
    width: 14px;
    height: 14px;
  }

  .post-links {
    margin: 1.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--ink-2);
  }
  .post-links a {
    padding: 0.75rem 0;
  }

  .post-nav {
    margin-top: 4.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 0 2rem;
    border-top: 1px solid var(--rule);
  }
  .post-nav-link {
    padding: 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-family: var(--font-sans);
    color: inherit;
    text-decoration: none;
  }
  .post-nav-label {
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  .post-nav-title {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .post-nav-link:hover .post-nav-title {
    color: var(--ink-2);
  }
  @media (min-width: 640px) {
    .post-nav-link.is-older {
      text-align: right;
    }
  }
</style>
